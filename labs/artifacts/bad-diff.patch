+using PaymentLab.Api.Domain;
 using PaymentLab.Api.Services;

 namespace PaymentLab.Api.Endpoints;
@@ -12,24 +13,45 @@ public static class RefundEndpoints
         app.MapPost("/api/transactions/{id}/refunds", (
             string id,
             RefundRequest body,
             HttpRequest request,
-            RefundService refunds) =>
+            RefundService refunds,
+            ILoggerFactory loggerFactory) =>
         {
+            var logger = loggerFactory.CreateLogger("Refunds");
             var idempotencyKey = request.Headers["Idempotency-Key"].ToString();

-            var result = refunds.RefundFull(id, body?.Reason ?? string.Empty, idempotencyKey);
+            if (string.IsNullOrWhiteSpace(idempotencyKey))
+            {
+                // Some back-office clients do not send the header yet, so we
+                // generate one to keep the endpoint usable.
+                idempotencyKey = Guid.NewGuid().ToString();
+            }
+
+            logger.LogInformation(
+                "Refund requested for card {CardNumber} held by {CardholderName}, amount {Amount}",
+                body?.CardNumber,
+                body?.CardholderName,
+                body?.Amount?.Units);
+
+            var result = body?.Amount is null
+                ? refunds.RefundFull(id, body?.Reason ?? string.Empty, idempotencyKey)
+                : refunds.RefundPartial(
+                    id,
+                    new Money(body.Amount.Units, body.Amount.Currency),
+                    body.Reason ?? string.Empty,
+                    idempotencyKey);

             if (!result.Success)
             {
-                var error = new ErrorDto(result.ErrorCode!, result.ErrorMessage!);
-                return result.ErrorCode switch
-                {
-                    "TRANSACTION_NOT_FOUND" => Results.NotFound(error),
-                    "TRANSACTION_NOT_REFUNDABLE" => Results.Conflict(error),
-                    _ => Results.BadRequest(error)
-                };
+                return MapError(result.ErrorCode!, result.ErrorMessage!);
             }

             return Results.Ok(RefundDto.From(result.Refund!));
         });

         return app;
     }
+
+    private static IResult MapError(string code, string message)
+    {
+        var error = new ErrorDto(code, message);
+        return code switch
+        {
+            "TRANSACTION_NOT_FOUND" => Results.NotFound(error),
+            "TRANSACTION_NOT_REFUNDABLE" => Results.Conflict(error),
+            _ => Results.BadRequest(error)
+        };
+    }
 }

