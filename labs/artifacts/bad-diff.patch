diff --git a/backend/src/PaymentLab.Api/Services/FeeCalculator.cs b/backend/src/PaymentLab.Api/Services/FeeCalculator.cs
index 3a1b2c4..9d8e7f6 100644
--- a/backend/src/PaymentLab.Api/Services/FeeCalculator.cs
+++ b/backend/src/PaymentLab.Api/Services/FeeCalculator.cs
@@ -24,4 +24,22 @@ public sealed class FeeCalculator
         var variable = (long)decimal.Floor(gross.Units * MdrRate);
         return new Money(variable + FixedFeeUnits, gross.Currency);
     }
+
+    /// <summary>
+    /// Returns the share of the merchant fee to give back for a partial refund.
+    /// </summary>
+    public Money CalculateFeeReversal(Money feeCharged, Money refundAmount, Money gross)
+    {
+        if (gross.Units == 0)
+        {
+            return new Money(0, gross.Currency);
+        }
+
+        double ratio = (double)refundAmount.Units / gross.Units;
+        long reversed = (long)Math.Round(
+            feeCharged.Units * ratio,
+            MidpointRounding.AwayFromZero);
+
+        return new Money(reversed, feeCharged.Currency);
+    }
 }

diff --git a/backend/src/PaymentLab.Api/Services/RefundService.cs b/backend/src/PaymentLab.Api/Services/RefundService.cs
index 5f4e3d2..1c2b3a4 100644
--- a/backend/src/PaymentLab.Api/Services/RefundService.cs
+++ b/backend/src/PaymentLab.Api/Services/RefundService.cs
@@ -104,5 +104,68 @@ public sealed class RefundService
         return RefundResult.Ok(refund);
     }

+    public RefundResult RefundPartial(
+        string transactionId,
+        Money amount,
+        string reason,
+        string idempotencyKey)
+    {
+        var transaction = _store.Find(transactionId);
+        if (transaction is null)
+        {
+            return RefundResult.Fail("TRANSACTION_NOT_FOUND", "Transaction not found.");
+        }
+
+        if (string.IsNullOrWhiteSpace(reason))
+        {
+            return RefundResult.Fail("REASON_REQUIRED", "A refund reason is required.");
+        }
+
+        if (amount.Units > transaction.Gross.Units)
+        {
+            return RefundResult.Fail(
+                "REFUND_EXCEEDS_PRINCIPAL",
+                $"Refund {amount} is larger than the transaction principal {transaction.Gross}.");
+        }
+
+        if (_clock.GetUtcNow() - transaction.AuthorizedAt > RefundPolicy.Window)
+        {
+            return RefundResult.Fail("REFUND_WINDOW_EXPIRED", "Refund window has expired.");
+        }
+
+        var alreadyPosted = transaction.Refunds
+            .FirstOrDefault(r => r.IdempotencyKey == idempotencyKey);
+        if (alreadyPosted is not null)
+        {
+            return RefundResult.Ok(alreadyPosted);
+        }
+
+        var feeReversal = _fees.CalculateFeeReversal(
+            transaction.MerchantFee,
+            amount,
+            transaction.Gross);
+
+        var refund = new Refund(
+            Id: NewRefundId(),
+            TransactionId: transaction.Id,
+            Amount: amount,
+            FeeReversed: feeReversal,
+            Reason: reason,
+            IdempotencyKey: idempotencyKey,
+            CreatedAt: _clock.GetUtcNow());
+
+        _store.AddRefund(transaction, refund, TransactionStatus.PartiallyRefunded);
+
+        return RefundResult.Ok(refund);
+    }
+
     internal static string NewRefundId() => "rfn_" + Guid.NewGuid().ToString("N")[..12];
 }

