<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline fallback. Use only when nuget.org is unreachable (corporate proxy):

      dotnet build src/PaymentLab.Api  configfile: ../nuget-offline.config

  The API project has no external package references, so it builds against the
  installed .NET shared framework alone. The xunit test project DOES need
  nuget.org; if it is blocked, run the dependency free harness instead:

      dotnet run  project: ../tools/selfcheck
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
